# Copy this file outside the repository, for example to /root/techroom-migration.env.
# Never commit the completed file.

# Public settings
DOMAIN=duisun.ru
APP_USER=techroom
APP_DIR=/srv/techroom/app
APP_PORT=3000
REPO=https://github.com/lawyerzeon86/techroom.git
BRANCH=main
LETSENCRYPT_EMAIL=

# Render PostgreSQL External Database URL.
# Temporarily allow the new REG.RU VPS public IP in Render before migration.
SOURCE_DATABASE_URL=

# Local PostgreSQL database created by the agent on the REG.RU VPS.
TARGET_DB_NAME=techroom
TARGET_DB_USER=techroom
TARGET_DB_PASSWORD=

# Application secrets. Copy the current production values from Render.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT_ID=
NEXT_PUBLIC_TELEGRAM_MANAGER_URL=
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
MAX_ADMIN_USER_ID=
NEXT_PUBLIC_MAX_MANAGER_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
OZON_CLIENT_ID=
OZON_API_KEY=
OZON_WAREHOUSE_ID=
WB_API_TOKEN=
WB_WAREHOUSE_ID=
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
VK_ACCESS_TOKEN=
VK_GROUP_ID=
YANDEX_MARKET_API_KEY=
YANDEX_MARKET_CAMPAIGN_ID=
CRON_SYNC_SECRET=
